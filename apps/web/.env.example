# Copy to .env.local. Pages, API, uploads and WebSocket use one service.
HOST=0.0.0.0
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=../../data
COOKIE_SECURE=false
# Empty for direct access. For local Nginx: TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=
# Server delivery retention; browser chat records do not expire automatically.
CHAT_TTL_DAYS=7
